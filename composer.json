{
    "name": "ichava/icon-sets-extras",
    "description": "44,013 SVGs from 20 open-licence icon, logo and emoji sets (MIT, Apache-2.0, CC0, CC BY), one directory per set, for Laravel 13 on the Ichava icon ecosystem.",
    "type": "ichava-icon-set",
    "keywords": [
        "laravel",
        "blade",
        "icons",
        "svg",
        "emoji",
        "logos",
        "ichava"
    ],
    "homepage": "https://github.com/ichava/icon-sets-extras",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "ichava@simtabi.com",
            "homepage": "https://simtabi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "ichava/core": "^0.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ichava/core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/db-tools.git"
        }
    ],
    "require-dev": {
        "composer/semver": "^3.4",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.6 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\IconSetsExtras\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\IconSetsExtras\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Ichava\\IconSetsExtras\\Providers\\IconsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "lint": "@pint",
        "format": "@pint-fix",
        "test": "vendor/bin/pest --parallel",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/ichava/icon-sets-extras",
        "issues": "https://github.com/ichava/icon-sets-extras/issues",
        "security": "https://github.com/ichava/icon-sets-extras/security/policy",
        "docs": "https://github.com/ichava/icon-sets-extras/tree/main/docs"
    }
}
